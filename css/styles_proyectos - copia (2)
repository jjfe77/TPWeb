/* ====== Estilos adicionales para proyectos - copia.html ====== */
/* Conserva el estilo general del sitio (styles.css) */

body {
  background-color: rgb(194, 194, 194);
  font-family: Arial, Helvetica, sans-serif;
  margin: 1px;
}

/* --- Encabezados de sección --- */
section h2 {
  text-align: center;
  font-style: italic;
  font-weight: bold;
  color: rgb(0, 70, 90);
  background: linear-gradient(to right, rgb(25, 179, 120), white);
  padding: 0.5em;
  border-radius: 10px;
  box-shadow: 3px 3px 8px rgb(109, 106, 106);
  margin: 1.5em auto;
  width: 80%;
}

/* --- Lista de proyectos --- */
#lista-proyectos {
  list-style: none;
  padding: 0;
  margin: 1em auto;
  width: 85%;
  background-color: rgb(240, 240, 240);
  border-radius: 12px;
  box-shadow: 3px 3px 8px rgb(109, 106, 106);
}

#lista-proyectos li {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1em;
  margin: 0.3em 0;
  border-bottom: 1px solid rgb(190, 190, 190);
  transition: background-color 0.3s ease;
}

#lista-proyectos li:hover {
  background-color: rgb(221, 255, 238);
}

#lista-proyectos span {
  color: rgb(25, 50, 50);
  font-size: 1em;
  font-weight: 500;
}

#lista-proyectos a {
  background-color: rgb(25, 179, 120);
  color: white;
  text-decoration: none;
  padding: 0.4em 1em;
  border-radius: 15px;
  font-weight: bold;
  transition: background-color 0.3s ease, transform 0.3s ease;
}

#lista-proyectos a:hover {
  background-color: rgb(0, 110, 100);
  transform: scale(1.05);
}

/* --- Sección subir proyectos --- */
.upload-hint {
  background: linear-gradient(to right, rgb(25, 179, 120), rgb(180, 220, 220));
  border-radius: 15px;
  padding: 1.5em;
  margin: 2em auto;
  width: 85%;
  box-shadow: 3px 3px 8px rgb(109, 106, 106);
  color: black;
}

.upload-hint h2 {
  background: none;
  color: rgb(0, 70, 90);
  box-shadow: none;
}

.upload-hint p {
  font-size: 1em;
  line-height: 1.6em;
  text-align: justify;
}

/* --- Ajustes responsive --- */
@media (max-width: 600px) {
  #lista-proyectos li {
    flex-direction: column;
    align-items: flex-start;
  }

  #lista-proyectos a {
    margin-top: 0.5em;
    width: 100%;
    text-align: center;
  }

  section h2 {
    width: 95%;
    font-size: 1.1em;
  }

  .upload-hint {
    width: 95%;
    font-size: 0.9em;
  }
}

    
    
    
    
    
    
    
    
